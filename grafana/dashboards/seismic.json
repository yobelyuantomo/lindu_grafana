    {
      "type": "stat",
      "title": "\ud83d\udda5\ufe0f Lindu Backend (Host Health)",
      "id": 22,
      "gridPos": {
        "w": 10,
        "h": 9,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
