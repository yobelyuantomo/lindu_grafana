      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT \n  time AS \"time\", \n  node_id AS \"metric\",\n  pga AS \"Total Guncangan (PGA)\"\nFROM sensor_telemetry \nWHERE node_id IN ($node_id) AND time > NOW() - INTERVAL '15 minutes' \nORDER BY time ASC\n",
